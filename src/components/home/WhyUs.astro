---
import Icon from '../Icon.astro';
import type { UiLang } from '../../i18n/ui';

interface Props { lang: UiLang }
const { lang } = Astro.props;

const copy = {
  fr: {
    eyebrow: 'Pourquoi nous',
    h2: "Plus qu'un nettoyage",
    intro: 'Un toit bien entretenu dure plus longtemps. On traite le vôtre comme un investissement, pas comme une visite de plus.',
    props: [
      { icon: 'leaf', title: 'Méthodes sûres et écologiques', desc: 'Des techniques durables qui protègent votre toiture et le voisinage.' },
      { icon: 'wrench', title: 'Une approche unique à chaque toit', desc: "On évalue votre toit pour ce qu'il est, pas selon une recette toute faite." },
      { icon: 'sparkle', title: 'Un investissement, pas une dépense', desc: 'Chaque entretien prolonge la durée de vie de votre toiture.' },
      { icon: 'check', title: 'Un prix juste, sans surprise', desc: 'On vous explique ce qu’on fait et pourquoi, avant de commencer.' },
    ],
  },
  en: {
    eyebrow: 'Why us',
    h2: 'More than a cleaning',
    intro: 'A well-maintained roof lasts longer. We treat yours like an investment, not just another visit.',
    props: [
      { icon: 'leaf', title: 'Safe, eco-friendly methods', desc: 'Durable techniques that protect your roof and the neighbourhood.' },
      { icon: 'wrench', title: 'A unique approach to every roof', desc: 'We assess your roof for what it is, not by a one-size formula.' },
      { icon: 'sparkle', title: 'An investment, not an expense', desc: 'Every service extends the lifespan of your roof.' },
      { icon: 'check', title: 'A fair price, no surprises', desc: 'We explain what we do and why, before we start.' },
    ],
  },
}[lang];
---

<section class="border-y border-line bg-surface-sunken py-16 md:py-24">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 class="mt-3 text-3xl md:text-4xl">{copy.h2}</h2>
      <p class="mt-4 text-lg text-ink-soft">{copy.intro}</p>
    </div>

    <div class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 reveal-children">
      {
        copy.props.map((p) => (
          <div class="flex gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-surface-raised text-accent-strong shadow-sm ring-1 ring-line">
              <Icon name={p.icon as any} size={22} />
            </span>
            <div>
              <h3 class="text-lg font-semibold leading-snug">{p.title}</h3>
              <p class="mt-1.5 text-[0.95rem] leading-relaxed text-ink-soft">{p.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
