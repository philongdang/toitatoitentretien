---
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import { route } from '../../lib/routes';
import type { UiLang } from '../../i18n/ui';

interface Props { lang: UiLang }
const { lang } = Astro.props;
const aboutHref = route('about', lang);

const copy = {
  fr: {
    eyebrow: 'La différence',
    h2a: 'On vous dit la vérité sur votre toit —',
    h2b: 'même quand ça nous coûte le contrat.',
    body: "Dans ce métier, la confiance compte plus que le vernis. On n'invente pas de problèmes et on ne vend pas ce dont vous n'avez pas besoin.",
    storyTitle: 'Une histoire vraie',
    story:
      "Une cliente nous a appelés pour faire nettoyer sa toiture. Après inspection, on lui a dit d'attendre un an : son toit n'en avait pas encore besoin. On est repartis sans facture.",
    attrib: 'L’histoire de Vanessa, cliente à Montréal',
    cta: 'Notre histoire',
  },
  en: {
    eyebrow: 'The difference',
    h2a: 'We tell you the truth about your roof —',
    h2b: 'even when it costs us the job.',
    body: "In this trade, trust matters more than polish. We don't invent problems, and we don't sell you what you don't need.",
    storyTitle: 'A true story',
    story:
      'A customer called us to have her roof cleaned. After inspecting it, we told her to wait a year — it didn’t need us yet. We left without a bill.',
    attrib: 'The story of Vanessa, a Montréal customer',
    cta: 'Our story',
  },
}[lang];
---

<section class="bg-slate text-white">
  <div class="container-page grid items-center gap-10 py-16 md:grid-cols-12 md:gap-12 md:py-24">
    <div class="md:col-span-6">
      <p class="eyebrow !text-[#f2a551]">{copy.eyebrow}</p>
      <h2 class="mt-4 text-3xl text-white md:text-[2.6rem] md:leading-[1.08]">
        {copy.h2a} <span class="text-[#f59153]">{copy.h2b}</span>
      </h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/70">{copy.body}</p>
      <div class="mt-8">
        <Button href={aboutHref} variant="dark" iconRight="arrow-up-right">{copy.cta}</Button>
      </div>
    </div>

    <div class="md:col-span-6">
      <figure class="relative rounded-xl border border-white/12 bg-slate-soft/40 p-7 md:p-9">
        <Icon name="quote" size={40} class="text-[#ee8a47]" />
        <p class="eyebrow mt-4 !text-white/45">{copy.storyTitle}</p>
        <blockquote class="mt-3 text-xl leading-relaxed text-white/90 md:text-2xl">
          {copy.story}
        </blockquote>
        <figcaption class="mt-6 flex items-center gap-2 text-sm text-white/55">
          <span class="h-px w-6 bg-[#ee8a47]"></span>
          {copy.attrib}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
