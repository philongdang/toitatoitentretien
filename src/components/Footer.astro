---
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import { business, regionsServed, services } from '../lib/business';
import { primaryNav, route, routes, servicePath } from '../lib/routes';
import type { UiLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang: UiLang; altLangPath: string }
const { lang, altLangPath } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const tagline =
  lang === 'fr'
    ? "Soin de toiture honnête, local et assuré — on vous dit la vérité sur votre toit."
    : 'Honest, local, insured roof care — we tell you the truth about your roof.';
---

<footer class="bg-slate text-white/75">
  <div class="container-page py-14 md:py-16">
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <Wordmark lang={lang} tone="light" />
        <p class="mt-4 max-w-xs text-[0.95rem] leading-relaxed text-white/65">{tagline}</p>
        <a
          href={business.social.facebook}
          rel="noopener"
          class="mt-5 inline-flex items-center gap-2 text-sm text-white/70 underline-offset-4 transition-colors hover:text-white hover:underline"
        >
          <Icon name="globe" size={18} /> Facebook
        </a>
      </div>

      <nav class="md:col-span-3" aria-label={t('footer.services')}>
        <h2 class="eyebrow !text-[#f2a551]">{t('footer.services')}</h2>
        <ul class="mt-4 space-y-2.5">
          {services.map((s) => (
            <li>
              <a
                href={servicePath(s.slug[lang], lang)}
                class="text-[0.95rem] text-white/75 underline-offset-4 transition-colors hover:text-white hover:underline"
              >
                {s.title[lang]}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="md:col-span-2" aria-label={t('footer.nav')}>
        <h2 class="eyebrow !text-[#f2a551]">{t('footer.nav')}</h2>
        <ul class="mt-4 space-y-2.5">
          {primaryNav.map((key) => (
            <li>
              <a
                href={route(key, lang)}
                class="text-[0.95rem] text-white/75 underline-offset-4 transition-colors hover:text-white hover:underline"
              >
                {t(routes[key].labelKey)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-3">
        <h2 class="eyebrow !text-[#f2a551]">{t('footer.contact')}</h2>
        <ul class="mt-4 space-y-3 text-[0.95rem]">
          <li>
            <a href={business.phone.href} data-track="call" class="inline-flex items-center gap-2 font-mono text-white transition-colors hover:text-[#f3a45a]">
              <Icon name="phone" size={18} /> {business.phone.display}
            </a>
          </li>
          <li>
            <a href={`mailto:${business.email}`} class="break-all text-white/75 underline-offset-4 transition-colors hover:text-white hover:underline">
              {business.email}
            </a>
          </li>
        </ul>
        <h2 class="eyebrow mt-6 !text-[#f2a551]">{t('footer.serviceArea')}</h2>
        <p class="mt-3 text-sm leading-relaxed text-white/60">{regionsServed.join(' · ')}</p>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 text-sm text-white/55 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {business.name}. {t('footer.rights')}</p>
      <a href={altLangPath} class="inline-flex items-center gap-1.5 underline-offset-4 transition-colors hover:text-white hover:underline" hreflang={lang === 'fr' ? 'en' : 'fr'}>
        <Icon name="globe" size={16} /> {t('lang.alt')}
      </a>
    </div>
  </div>
</footer>
